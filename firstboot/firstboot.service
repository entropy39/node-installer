[Unit]
Description=Entropy39 interactive first-boot setup
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service
OnSuccess=getty-restore.service

[Service]
Type=idle
ExecStart=/sbin/agetty --noissue --noclear --autologin root --login-program /usr/local/sbin/firstboot tty1 linux
ExecStopPost=/usr/local/sbin/firstboot-cleanup $SERVICE_RESULT
Restart=on-failure
RestartSec=2
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
StandardInput=tty
StandardOutput=tty
StandardError=tty

[Install]
WantedBy=multi-user.target
