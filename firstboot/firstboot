#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly INSTALL_DIR=/usr/local/lib/node-installer
readonly STATE_DIR=/var/lib/entropy39-node
readonly LOG_DIR=/var/log/entropy39-node
readonly COMMIT_RECORD=$STATE_DIR/installer-commit
readonly DIRTY_RECORD=$STATE_DIR/installer-dirty
readonly SNAPSHOT_RECORD=$STATE_DIR/installer-snapshot-sha256
readonly COMPLETE_MARKER=$STATE_DIR/setup-complete

log() { printf '==> %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; return 1; }

prepare_logging() {
    install -d -o root -g root -m 0755 "$STATE_DIR"
    install -d -o root -g adm -m 0750 "$LOG_DIR"
    touch "$LOG_DIR/setup.log"
    chown root:adm "$LOG_DIR/setup.log"
    chmod 0640 "$LOG_DIR/setup.log"
}

check_environment() {
    [[ $EUID -eq 0 ]] || die "First-boot setup must run as root."
    [[ -t 0 ]] || die "First-boot setup requires an interactive console."
    [[ $(tty) == /dev/tty1 ]] || die "First-boot setup may run only on the local tty1 console."
    local command_name
    for command_name in awk find grep install sed sha256sum stat systemctl tee; do
        command -v "$command_name" >/dev/null 2>&1 || die "Required command not found: $command_name"
    done
}

metadata_value() {
    local key=$1
    [[ $(grep -c "^${key}=" "$INSTALL_DIR/installer-build-info") -eq 1 ]] || return 1
    sed -n "s/^${key}=//p" "$INSTALL_DIR/installer-build-info"
}

verify_installer_snapshot() {
    local commit dirty snapshot_sha recorded_commit recorded_dirty recorded_snapshot
    [[ -d $INSTALL_DIR && ! -L $INSTALL_DIR ]] || return 1
    [[ -f $INSTALL_DIR/installer-build-info && -f $INSTALL_DIR/installer-files.sha256 && \
       -f $INSTALL_DIR/installer-snapshot.sha256 ]] || return 1
    ! find "$INSTALL_DIR" -type l -print -quit | grep -q . || return 1
    ! find "$INSTALL_DIR" ! -user root -print -quit | grep -q . || return 1
    ! find "$INSTALL_DIR" -perm /022 -print -quit | grep -q . || return 1
    (cd "$INSTALL_DIR" && sha256sum --quiet -c installer-files.sha256 && \
        sha256sum --quiet -c installer-snapshot.sha256) || return 1
    [[ -x $INSTALL_DIR/firstboot/setup && -r $INSTALL_DIR/firstboot/app-catalog.sh ]] || return 1

    commit=$(metadata_value installer_commit) || return 1
    dirty=$(metadata_value installer_dirty) || return 1
    snapshot_sha=$(sha256sum "$INSTALL_DIR/installer-files.sha256" | awk '{print $1}') || return 1
    [[ $commit =~ ^[0-9a-f]{40}$ && ( $dirty == yes || $dirty == no ) && $snapshot_sha =~ ^[0-9a-f]{64}$ ]] || return 1

    [[ -f $COMMIT_RECORD && -f $DIRTY_RECORD && -f $SNAPSHOT_RECORD ]] || return 1
    read -r recorded_commit <"$COMMIT_RECORD" || return 1
    read -r recorded_dirty <"$DIRTY_RECORD" || return 1
    read -r recorded_snapshot <"$SNAPSHOT_RECORD" || return 1
    [[ $recorded_commit == "$commit" && $recorded_dirty == "$dirty" && $recorded_snapshot == "$snapshot_sha" ]] || return 1
}

failure_menu() {
    local choice
    while true; do
        printf '\nEntropy39 setup did not complete. Choose an action:\n'
        printf '  1) Retry setup\n'
        printf '  2) Root maintenance shell\n'
        printf '  3) Reboot\n'
        printf '  4) Shut down\n'
        read -r -p 'Selection [1]: ' choice
        case ${choice:-1} in
            1) return 0 ;;
            2) printf 'Type exit to return to the Entropy39 recovery menu.\n'; /bin/bash --login -i ;;
            3) systemctl reboot; exit 0 ;;
            4) systemctl poweroff; exit 0 ;;
            *) printf 'Please choose 1, 2, 3 or 4.\n' ;;
        esac
    done
}

main() {
    printf '\n===== Entropy39 first-boot setup: %s =====\n' "$(date --iso-8601=seconds)"
    check_environment
    if [[ -f $COMPLETE_MARKER ]]; then
        log "Entropy39 setup is already complete."
        return 0
    fi
    while true; do
        if verify_installer_snapshot && "$INSTALL_DIR/firstboot/setup"; then return 0; fi
        if ! verify_installer_snapshot; then
            printf 'ERROR: The embedded installer snapshot failed integrity or provenance verification.\n' >&2
        fi
        failure_menu
    done
}

prepare_logging
set +e
main "$@" 2>&1 | tee -a "$LOG_DIR/setup.log"
main_status=${PIPESTATUS[0]}
set -e
exit "$main_status"
